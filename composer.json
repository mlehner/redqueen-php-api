{
    "type": "project",
    "require": {
        "php": "8.1.*",
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-tokenizer": "*",
        "doctrine/dbal": "^3.10.4",
        "doctrine/doctrine-bundle": "^2.13.3",
        "guzzlehttp/guzzle": "^7.10.0",
        "kevinrob/guzzle-cache-middleware": "^4.1.2",
        "monolog/monolog": "~2.3.5",
        "symfony/cache": "5.4.*",
        "symfony/dotenv": "5.4.*",
        "symfony/flex": "^1.22",
        "symfony/framework-bundle": "5.4.*",
        "symfony/runtime": "5.4.*",
        "symfony/serializer": "5.4.*",
        "symfony/validator": "5.4.*",
        "symfony/yaml": "5.4.*",
        "web-token/jwt-checker": "^2.2.11",
        "web-token/jwt-key-mgmt": "^2.2.11",
        "web-token/jwt-signature": "^2.2.11",
        "web-token/jwt-signature-algorithm-rsa": "^2.2.11"
    },
    "autoload": {
        "psr-4": { "BLInc\\": "src/" }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^7.0",
        "symfony/browser-kit": "^5.4.45"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "5.4.*"
        },
        "public-dir": "web"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    }
}
